@{
    ViewData["Title"] = "Home";
}

<section class="py-5 text-center">
    <div class="container py-5">
        <h1 class="display-4 fw-bold">Manage Your Food Inventory Smarter</h1>

        <p class="lead text-muted mt-3">
            Keep track of your food stock, monitor expiry dates,
            and reduce unnecessary food waste with FreshTrack.
        </p>

        <a href="#features" class="btn btn-success btn-lg mt-3">
            Explore Features
        </a>
    </div>
</section>

<section id="features" class="py-5 bg-light">
    <div class="container">
        <h2 class="text-center fw-bold mb-4">Our Features</h2>

        <div class="row g-4">
            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center p-4">
                        <h5 class="card-title">Inventory Management</h5>
                        <p class="card-text text-muted">
                            Add, update, and manage your food products
                            and their quantities.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center p-4">
                        <h5 class="card-title">Expiry Tracking</h5>
                        <p class="card-text text-muted">
                            Monitor expiry dates and identify products
                            that are close to expiring.
                        </p>
                    </div>
                </div>
            </div>

            <div class="col-md-4">
                <div class="card h-100 shadow-sm border-0">
                    <div class="card-body text-center p-4">
                        <h5 class="card-title">Waste Monitoring</h5>
                        <p class="card-text text-muted">
                            Keep records of food usage and wastage
                            to reduce unnecessary losses.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<section id="about" class="py-5">
    <div class="container text-center">
        <h2 class="fw-bold">About FreshTrack</h2>
        <p class="text-muted mt-3">
            FreshTrack is a food inventory management system designed
            to help households and small businesses organize their
            food stock, track expiry dates, and minimize food waste.
        </p>
    </div>
</section>